generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String
  firstName        String?
  lastName         String?
  matricule        String?  @unique
  password         String
  role             String   @default("USER")
  suspended        Boolean  @default(false)
  emailVerified    Boolean  @default(true)
  location         String   @default("Joinville")
  nickname         String?
  visibleInMembers Boolean  @default(true)
  pushToken        String?
  createdAt        DateTime @default(now())

  loans                  Loan[]
  ratings                Rating[]
  emailVerifications     EmailVerification[]
  passwordResetTokens    PasswordResetToken[]
  sessionRegistrations   GameSessionRegistration[]
  notifications          UserNotification[]
  createdSessions        GameSession[]              @relation("CreatedSessions")
  privateInvitations     PrivateSessionInvitation[]
  gameWaitlists          GameWaitlist[]
  sessionReminderLogs    SessionReminderLog[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id         String   @id @default(cuid())
  bggId      String?  @unique
  name       String
  type       String
  category   String   @default("famille")
  summary    String?
  minAge     Int?
  minPlayers Int?
  maxPlayers Int?
  duration   Int?
  coverUrl   String?
  barcode    String?
  status     String   @default("AVAILABLE")
  location   String   @default("Joinville")
  addedAt    DateTime @default(now())

  loans     Loan[]
  ratings   Rating[]
  reports   GameReport[]
  waitlists GameWaitlist[]
}

model GameReport {
  id           String   @id @default(cuid())
  gameId       String
  reporterId   String
  reporterName String
  message      String
  createdAt    DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([gameId])
}

model Loan {
  id             String    @id @default(cuid())
  userId         String
  gameId         String
  borrowedAt     DateTime  @default(now())
  dueAt          DateTime
  returnedAt     DateTime?
  extendedCount  Int       @default(0)
  reminderSentAt DateTime?

  user      User           @relation(fields: [userId], references: [id])
  game      Game           @relation(fields: [gameId], references: [id])
  reminders LoanReminder[]

  @@index([userId])
  @@index([gameId])
}

model LoanReminder {
  id     String   @id @default(cuid())
  loanId String
  type   String
  sentAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model EmailConfig {
  id                   String   @id @default("singleton")
  reminderDaysBefore   Int      @default(2)
  overdueFrequencyDays Int      @default(1)
  reminderSubject      String   @default("Rappel : rendez \"{{gameName}}\" avant le {{dueAt}}")
  reminderBody         String   @default("Bonjour {{userName}},\n\nVotre emprunt du jeu \"{{gameName}}\" arrive à échéance le {{dueAt}}.\nPensez à le rendre à la ludothèque ou à le prolonger depuis l'application.\n\nLudothèque BRED")
  overdueSubject       String   @default("⚠ Retard : veuillez rendre \"{{gameName}}\"")
  overdueBody          String   @default("Bonjour {{userName}},\n\nLe jeu \"{{gameName}}\" aurait dû être rendu le {{dueAt}}.\nMerci de le rapporter à la ludothèque dès que possible.\n\nLudothèque BRED")
  sessionInviteSubject    String   @default("🎲 Invitation session : \"{{sessionName}}\" — le {{sessionDate}}")
  sessionInviteBody       String   @default("Bonjour {{userName}},\n\nVous avez été invité(e) à la session ludique \"{{sessionName}}\".\n\nDate : {{sessionDate}}\nHeure : {{sessionTime}}\nLieu : {{sessionLocation}}\n\nCliquez ici pour vous inscrire : {{registerUrl}}\n\nLudothèque BRED")
  sessionReminderSubject  String   @default("⏰ Rappel session : \"{{sessionName}}\" c'est bientôt !")
  sessionReminderBody     String   @default("Bonjour {{userName}},\n\nRappel : vous êtes inscrit(e) à la session ludique \"{{sessionName}}\".\n\nDate : {{sessionDate}}\nHeure : {{sessionTime}}\nLieu : {{sessionLocation}}\n\nLudothèque BRED")
  sessionReminderDays1 Int @default(7)
  sessionReminderDays2 Int @default(1)
  manualOverdueSubject String   @default("⚠ Retard (rappel admin) : veuillez rendre \"{{gameName}}\"")
  manualOverdueBody    String   @default("Bonjour {{userName}},\n\nCe rappel vous est envoyé par l'administrateur de la ludothèque.\n\nLe jeu \"{{gameName}}\" aurait dû être rendu le {{dueAt}}.\nMerci de le rapporter dès que possible.\n\nLudothèque BRED")
  waitlistSubject      String   @default("💡 Quelqu'un attend \"{{gameName}}\" — pensez à le rendre !")
  waitlistBody         String   @default("Bonjour {{userName}},\n\nUn(e) collègue attend de pouvoir emprunter le jeu que vous avez actuellement :\n\n{{gameName}}\n\nSi vous avez fini de jouer, pensez à le ramener à la ludothèque !\n\nVoir le jeu : {{gameUrl}}\n\nLudothèque BRED")
  sendHour             Int      @default(8)
  updatedAt            DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GameSession {
  id              String   @id @default(cuid())
  name            String
  date            DateTime
  location        String
  startTime       String
  imageUrl        String?
  info            String?
  isPrivate       Boolean  @default(false)
  createdByUserId String?
  maxParticipants Int?
  createdAt       DateTime @default(now())

  createdBy      User?                      @relation("CreatedSessions", fields: [createdByUserId], references: [id], onDelete: SetNull)
  registrations  GameSessionRegistration[]
  notifications  UserNotification[]
  invitations    PrivateSessionInvitation[]
  reminderLogs   SessionReminderLog[]
}

model GameSessionRegistration {
  id           String   @id @default(cuid())
  sessionId    String
  userId       String
  guestName    String?
  registeredAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model PrivateSessionInvitation {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  status    String   @default("PENDING")
  invitedAt DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
}

model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  sessionId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session GameSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([gameId])
}

model GameWaitlist {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
}

model SessionReminderLog {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  daysBefore Int
  sentAt    DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, daysBefore])
  @@index([sessionId])
  @@index([userId])
}
