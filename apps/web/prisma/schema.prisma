generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  firstName     String?
  lastName      String?
  matricule     String?  @unique
  password      String
  role          String   @default("USER")
  suspended     Boolean  @default(false)
  emailVerified Boolean  @default(true)
  location      String   @default("Joinville")
  createdAt     DateTime @default(now())

  loans              Loan[]
  ratings            Rating[]
  emailVerifications EmailVerification[]
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Game {
  id         String   @id @default(cuid())
  bggId      String?  @unique
  name       String
  type       String
  category   String   @default("famille")
  summary    String?
  minAge     Int?
  minPlayers Int?
  maxPlayers Int?
  duration   Int?
  coverUrl   String?
  barcode    String?  @unique
  status     String   @default("AVAILABLE")
  location   String   @default("Joinville")
  addedAt    DateTime @default(now())

  loans   Loan[]
  ratings Rating[]
}

model Loan {
  id             String    @id @default(cuid())
  userId         String
  gameId         String
  borrowedAt     DateTime  @default(now())
  dueAt          DateTime
  returnedAt     DateTime?
  extendedCount  Int       @default(0)
  reminderSentAt DateTime?

  user      User           @relation(fields: [userId], references: [id])
  game      Game           @relation(fields: [gameId], references: [id])
  reminders LoanReminder[]

  @@index([userId])
  @@index([gameId])
}

model LoanReminder {
  id     String   @id @default(cuid())
  loanId String
  type   String
  sentAt DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
}

model EmailConfig {
  id                   String   @id @default("singleton")
  reminderDaysBefore   Int      @default(2)
  overdueFrequencyDays Int      @default(3)
  reminderSubject      String   @default("Rappel : rendez \"{{gameName}}\" avant le {{dueAt}}")
  reminderBody         String   @default("Bonjour {{userName}},\n\nVotre emprunt du jeu \"{{gameName}}\" arrive à échéance le {{dueAt}}.\nPensez à le rendre à la ludothèque ou à le prolonger depuis l'application.\n\nLudothèque BRED")
  overdueSubject       String   @default("⚠ Retard : veuillez rendre \"{{gameName}}\"")
  overdueBody          String   @default("Bonjour {{userName}},\n\nLe jeu \"{{gameName}}\" aurait dû être rendu le {{dueAt}}.\nMerci de le rapporter à la ludothèque dès que possible.\n\nLudothèque BRED")
  updatedAt            DateTime @updatedAt
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([gameId])
}
