{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "20.11.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "20.11.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.ludigest.fr"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.11.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.ludigest.fr"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
