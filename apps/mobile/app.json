{
  "expo": {
    "name": "LudiGest",
    "slug": "ludigest",
    "version": "1.66.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ludigest",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#C8102E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.bred.ludigest"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8102E"
      },
      "package": "fr.bred.ludigest",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LudiGest utilise la caméra pour scanner les codes-barres des jeux."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#d24a1f",
          "defaultChannel": "default"
        }
      ],
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c6beaf44-8c96-42de-ab1d-61eb6744f8ea"
      }
    }
  }
}
